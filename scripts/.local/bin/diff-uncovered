#!/usr/bin/env node
// diff-uncovered <base> <coverage-final.json>... — the added and changed lines
// since the merge base of <base> and HEAD, committed, staged or not, that no
// test executed, by the istanbul-format reports given (vitest:
// --coverage.reporter=json; c8/nyc: --reporter=json). Untracked files are not
// judged until they are added.
//
// Prints one path:line per uncovered line, then a count. Exit 1 when any line
// is uncovered, 0 when none. A changed source file absent from every report is
// listed under "no report covers": it is outside the coverage include, or no
// report was taken for its workspace. Tests, docs and styles are never listed.
//
// Two granularities, judged separately. A statement line is covered when a
// statement starting on it ran. A branch line, printed as "path:line branch",
// is covered when every arm of each branch starting on it ran: a line whose
// statement ran can still hold an `if` whose other arm no test took. A line
// with neither (a brace, a comment, an import) is not judged either way.
"use strict";
const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const [base, ...reports] = process.argv.slice(2);
if (!base || !reports.length) {
  process.stderr.write("usage: diff-uncovered <base> <coverage-final.json>...\n");
  process.exit(2);
}
// No buffer cap: a lockfile or generated-file rewrite puts the diff past the 1 MiB default.
const git = (...args) => execFileSync("git", args, { encoding: "utf8", maxBuffer: Infinity });
const root = git("rev-parse", "--show-toplevel").trim();

// The path in a "+++ " header. Git C-quotes one holding a control character,
// `"` or `\` (and any non-ASCII byte under the default core.quotePath), and
// appends a tab to an unquoted one holding a space.
function headerPath(rest) {
  if (!rest.startsWith('"')) return rest.replace(/\t$/, "");
  const esc = { a: 7, b: 8, f: 12, n: 10, r: 13, t: 9, v: 11 };
  const bytes = [];
  for (let i = 1; i < rest.length && rest[i] !== '"'; i++) {
    if (rest[i] !== "\\") {
      const cp = rest.codePointAt(i);
      bytes.push(...Buffer.from(String.fromCodePoint(cp)));
      if (cp > 0xffff) i++;
    } else if (/[0-7]/.test(rest[i + 1])) {
      bytes.push(parseInt(rest.slice(i + 1, i + 4), 8));
      i += 3;
    } else {
      const c = rest[++i];
      bytes.push(esc[c] ?? c.charCodeAt(0));
    }
  }
  return Buffer.from(bytes).toString("utf8");
}

// Added lines per file, from unified diff hunks: "+c,d" is d lines from c.
// The flags override every diff config that would move the "b/" prefix, root
// the paths elsewhere or rewrite the text. A "+++ " line is a header only
// between "diff --git" and the first hunk: inside one it is an added "++ " line.
const added = new Map();
let file = null;
let inHeader = false;
const diff = git("diff", "--merge-base", "--default-prefix", "--no-relative", "--no-textconv", "--no-ext-diff", "--no-color", "-U0", base, "--");
for (const line of diff.split("\n")) {
  if (line.startsWith("diff --git ")) {
    inHeader = true;
    file = null;
  } else if (inHeader && line.startsWith("+++ ")) {
    const p = headerPath(line.slice(4));
    file = p.startsWith("b/") ? path.join(root, p.slice(2)) : null;
  } else if (line.startsWith("@@")) {
    inHeader = false;
    if (!file) continue;
    const m = line.match(/\+(\d+)(?:,(\d+))?/);
    const from = Number(m[1]);
    const n = m[2] === undefined ? 1 : Number(m[2]);
    if (!added.has(file)) added.set(file, new Set());
    for (let i = 0; i < n; i++) added.get(file).add(from + i);
  }
}

// Lines that started a statement, and those whose statement ran, per file;
// lines that started a branch, and those where some arm never ran. A file in
// several reports is covered by a run in any of them, so a branch line is
// untaken only when no report took one of its arms.
const seen = new Map();
const ran = new Map();
const branchSeen = new Map();
const armRuns = new Map();
for (const report of reports) {
  const data = JSON.parse(fs.readFileSync(report, "utf8"));
  for (const entry of Object.values(data)) {
    const p = path.resolve(entry.path);
    if (!seen.has(p)) seen.set(p, new Set()), ran.set(p, new Set()), branchSeen.set(p, new Set()), armRuns.set(p, new Map());
    for (const [id, loc] of Object.entries(entry.statementMap ?? {})) {
      seen.get(p).add(loc.start.line);
      if (entry.s?.[id] > 0) ran.get(p).add(loc.start.line);
    }
    for (const [id, br] of Object.entries(entry.branchMap ?? {})) {
      const line = br.loc?.start.line ?? br.line;
      branchSeen.get(p).add(line);
      const counts = entry.b?.[id] ?? [];
      // Keyed by span, not id: ids are per report, and nested branches share a start.
      const key = br.loc ? `${line}:${br.loc.start.column}-${br.loc.end.line}:${br.loc.end.column}/${counts.length}` : `${line}:#${id}`;
      const prev = armRuns.get(p).get(key) ?? counts.map(() => 0);
      armRuns.get(p).set(key, prev.map((n, i) => n + (counts[i] ?? 0)));
    }
  }
}
const untaken = new Map();
for (const [p, arms] of armRuns) {
  untaken.set(p, new Set());
  for (const [key, counts] of arms) if (counts.some((n) => n === 0)) untaken.get(p).add(Number(key.split(":")[0]));
}

const SOURCE = /\.(m?[jt]sx?|cjs)$/;
const isTest = (p) => /(^|\/)(tests?|__tests__|e2e|spec)\//.test(p) || /\.(test|spec)\./.test(p);
const missing = [];
let uncovered = 0;
let judged = 0;
let branchUncovered = 0;
let branchJudged = 0;
for (const [p, lines] of [...added].sort()) {
  if (!seen.has(p)) {
    const rel = path.relative(root, p);
    if (SOURCE.test(rel) && !isTest(rel)) missing.push(rel);
    continue;
  }
  for (const l of [...lines].sort((a, b) => a - b)) {
    if (seen.get(p).has(l)) {
      judged++;
      if (!ran.get(p).has(l)) uncovered++, process.stdout.write(`${path.relative(root, p)}:${l}\n`);
    }
    if (branchSeen.get(p).has(l)) {
      branchJudged++;
      if (untaken.get(p).has(l)) branchUncovered++, process.stdout.write(`${path.relative(root, p)}:${l} branch\n`);
    }
  }
}
if (missing.length) process.stdout.write(`no report covers: ${missing.join(", ")}\n`);
process.stdout.write(`${uncovered} of ${judged} added statement lines and ${branchUncovered} of ${branchJudged} added branch lines uncovered\n`);
process.exit(uncovered || branchUncovered ? 1 : 0);
