#!/usr/bin/env bash
# claude-gate — show and flip the per-repo Claude permission toggles.
#
#   claude-gate                 status for this repo
#   claude-gate remote on|off|auto
#                               git push / gh:       ask <-> deny   (default on);
#                               auto allows a push of the current branch and a
#                               draft PR, and turns review on, since pre-push's
#                               review gate is what makes that push safe
#   claude-gate merge  on|off|auto
#                               LOCAL merge/rebase:  ask <-> deny   (default on);
#                               auto allows one onto a named local branch from a
#                               clean tree, for the main checkout and its worktrees
#   claude-gate review on|off   require a fresh-context review before push
#                                                                    (default off)
#   claude-gate all off         tighten every toggle for this repo
#
# remote and merge are on unless the repo root carries an opt-out marker, so
# "off" writes a file and "on" removes it. review is the reverse: it is off
# unless the repo is listed in review-gate-repos. merge auto and remote auto
# are opt-in markers, .claude-merge-auto and .claude-remote-auto, in the main
# checkout; a checkout's -off marker still wins over them.
#
# Flipping one toggle offers the others, because the failure mode is tightening
# a repo months ago and forgetting the rest are still set.
#
# No toggle exists for remote merge/rebase or `gh pr merge`. Those are denied
# permanently, by bash-write-gate.sh and by the pre-rebase / pre-merge-commit
# git hooks independently.
set -euo pipefail

REPOS_FILE="$HOME/.claude/hooks/review-gate-repos"

die() { echo "claude-gate: $1" >&2; exit 1; }

root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repo"

# review-gate and merge auto key off the main checkout, not the worktree, so a
# linked worktree shares its parent's setting while keeping its own -off markers.
common=$(git rev-parse --git-common-dir)
[[ "$common" != /* ]] && common=$(cd "$common" && pwd)
review_root=$(dirname "$common")

# Compare physical paths: on macOS /var is a symlink to /private/var, and the
# two rev-parse calls do not agree on which form to return.
root=$(cd "$root" && pwd -P)
review_root=$(cd "$review_root" && pwd -P)

state() {
  case $1 in
    remote)
      if   [[ -f "$root/.claude-remote-off" ]]; then echo off
      elif [[ -f "$review_root/.claude-remote-auto" ]]; then echo auto
      else echo on; fi ;;
    merge)
      if   [[ -f "$root/.claude-merge-off" ]]; then echo off
      elif [[ -f "$review_root/.claude-merge-auto" ]]; then echo auto
      else echo on; fi ;;
    review) [[ -f "$REPOS_FILE" ]] && grep -Fxq "$review_root" "$REPOS_FILE" && echo on || echo off ;;
  esac
}

describe() {
  case $1 in
    remote) echo "git push / gh:        on = ask,   off = deny,  auto = allow own-branch push and draft PR" ;;
    merge)  echo "LOCAL merge / rebase: on = ask,   off = deny,  auto = allow onto a local branch, clean tree" ;;
    review) echo "on = push blocked until the branch diff passes review" ;;
  esac
}

apply() { # toggle on|off
  case "$1:$2" in
    remote:on)  rm -f "$root/.claude-remote-off" "$review_root/.claude-remote-auto" ;;
    remote:off) : > "$root/.claude-remote-off"; rm -f "$review_root/.claude-remote-auto" ;;
    remote:auto)
      : > "$review_root/.claude-remote-auto"; rm -f "$review_root/.claude-remote-off"
      apply review on ;;
    merge:on)   rm -f "$root/.claude-merge-off" "$review_root/.claude-merge-auto" ;;
    merge:off)  : > "$root/.claude-merge-off"; rm -f "$review_root/.claude-merge-auto" ;;
    merge:auto) : > "$review_root/.claude-merge-auto"; rm -f "$review_root/.claude-merge-off" ;;
    review:on)
      mkdir -p "$(dirname "$REPOS_FILE")"
      grep -Fxq "$review_root" "$REPOS_FILE" 2>/dev/null || echo "$review_root" >> "$REPOS_FILE" ;;
    review:off)
      [[ -f "$REPOS_FILE" ]] || return 0
      grep -Fxv "$review_root" "$REPOS_FILE" > "$REPOS_FILE.tmp" || true
      mv "$REPOS_FILE.tmp" "$REPOS_FILE" ;;
  esac
  printf '  %-7s %s\n' "$1" "$(state "$1")"
  [[ "$2" == auto && "$review_root" != "$root" ]] &&
    echo "  marker written at the main checkout: $review_root"
  return 0
}

status() {
  echo "repo: $root"
  [[ "$review_root" != "$root" ]] && echo "main checkout: $review_root (review-gate and merge auto are shared with it)"
  for t in remote merge review; do
    printf '  %-7s %-4s  %s\n' "$t" "$(state "$t")" "$(describe "$t")"
  done
  # The markers used to be opt-IN (.claude-*-ok). Leftovers now do nothing, and
  # silently reading as "still configured" is exactly the confusion to avoid.
  for legacy in .claude-remote-ok .claude-merge-ok; do
    [[ -f "$root/$legacy" ]] &&
      echo "  note: $legacy is a leftover from the old opt-in scheme and has no effect — delete it"
  done
  return 0
}

# Flipping one toggle is the moment to reconsider the others.
offer_others() { # toggle state
  [[ -t 0 ]] || return 0
  for t in remote merge review; do
    [[ "$t" == "$1" ]] && continue
    # remote auto just turned review on, and depends on it.
    [[ "$1:$2:$t" == remote:auto:review ]] && continue
    cur=$(state "$t")
    want=$([[ "$cur" == on ]] && echo off || echo on)
    read -r -p "  also turn $t $want? ($(describe "$t")) [y/N] " ans || return 0
    [[ "$ans" =~ ^[Yy] ]] && apply "$t" "$want"
  done
}

case "${1:-}" in
  ""|status) status ;;
  all)
    [[ "${2:-}" == off ]] || die "only 'all off' is supported"
    for t in remote merge review; do apply "$t" off; done ;;
  remote|merge)
    case "${2:-}" in on|off|auto) ;; *) die "usage: claude-gate $1 on|off|auto" ;; esac
    apply "$1" "$2"
    offer_others "$1" "$2" ;;
  review)
    case "${2:-}" in on|off) ;; *) die "usage: claude-gate review on|off" ;; esac
    apply "$1" "$2"
    offer_others "$1" "$2" ;;
  *) die "unknown toggle '${1}' — try: status, remote, merge, review, all off" ;;
esac
