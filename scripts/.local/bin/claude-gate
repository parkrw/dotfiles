#!/usr/bin/env bash
# claude-gate — show and flip the per-repo Claude permission toggles.
#
#   claude-gate                 status for this repo
#   claude-gate remote on|off   feature-branch push, PR create/edit, comments:
#                               allow <-> deny;
#                               other gh writes: ask <-> deny       (default on)
#   claude-gate merge  on|off   merge/rebase:        allow <-> deny (default on)
#   claude-gate review on|off   require a fresh-context review before push
#                                                                    (default off)
#   claude-gate ftl    on|off   run every prompt through /ftl       (default off)
#   claude-gate all off         tighten every toggle for this repo
#
# remote and merge are on unless the repo root carries an opt-out marker, so
# "off" writes a file and "on" removes it. review is the reverse: it is off
# unless the repo is listed in review-gate-repos. ftl is an opt-in marker,
# .claude-ftl, in the main checkout, read by ftl-every-prompt.sh. It is a working method, not a
# permission, so it stays out of "all off" and the offers.
#
# Flipping one toggle offers the others, because the failure mode is tightening
# a repo months ago and forgetting the rest are still set.
#
# No toggle enables a push to main/master or the default branch, or
# `gh pr merge`. bash-write-gate.sh and the pre-push git hook deny those
# permanently.
set -euo pipefail

REPOS_FILE="$HOME/.claude/hooks/review-gate-repos"

die() { echo "claude-gate: $1" >&2; exit 1; }

root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repo"

# review-gate and ftl key off the main checkout, not the worktree, so a
# linked worktree shares its parent's setting while keeping its own -off markers.
common=$(git rev-parse --git-common-dir)
[[ "$common" != /* ]] && common=$(cd "$common" && pwd)
review_root=$(dirname "$common")

# Compare physical paths: on macOS /var is a symlink to /private/var, and the
# two rev-parse calls do not agree on which form to return.
root=$(cd "$root" && pwd -P)
review_root=$(cd "$review_root" && pwd -P)

state() {
  case $1 in
    remote)
      [[ -f "$root/.claude-remote-off" ]] && echo off || echo on ;;
    merge)  [[ -f "$root/.claude-merge-off" ]] && echo off || echo on ;;
    review) [[ -f "$REPOS_FILE" ]] && grep -Fxq "$review_root" "$REPOS_FILE" && echo on || echo off ;;
    ftl)    [[ -f "$review_root/.claude-ftl" ]] && echo on || echo off ;;
  esac
}

describe() {
  case $1 in
    remote) echo "push / gh:            on = allow feature-branch push, PR create/edit and comments, ask other gh; off = deny" ;;
    merge)  echo "merge / rebase:       on = allow, off = deny" ;;
    review) echo "on = push blocked until the branch diff passes review" ;;
    ftl)    echo "on = every prompt runs through /ftl" ;;
  esac
}

apply() { # toggle on|off
  case "$1:$2" in
    remote:on)  rm -f "$root/.claude-remote-off" ;;
    remote:off) : > "$root/.claude-remote-off" ;;
    merge:on)   rm -f "$root/.claude-merge-off" ;;
    merge:off)  : > "$root/.claude-merge-off" ;;
    review:on)
      mkdir -p "$(dirname "$REPOS_FILE")"
      grep -Fxq "$review_root" "$REPOS_FILE" 2>/dev/null || echo "$review_root" >> "$REPOS_FILE" ;;
    review:off)
      [[ -f "$REPOS_FILE" ]] || return 0
      grep -Fxv "$review_root" "$REPOS_FILE" > "$REPOS_FILE.tmp" || true
      mv "$REPOS_FILE.tmp" "$REPOS_FILE" ;;
    ftl:on)     : > "$review_root/.claude-ftl" ;;
    ftl:off)    rm -f "$review_root/.claude-ftl" ;;
  esac
  printf '  %-7s %s\n' "$1" "$(state "$1")"
  [[ "$1:$2" == ftl:on && "$review_root" != "$root" ]] &&
    echo "  marker written at the main checkout: $review_root"
  return 0
}

status() {
  echo "repo: $root"
  [[ "$review_root" != "$root" ]] && echo "main checkout: $review_root (review-gate and ftl are shared with it)"
  for t in remote merge review ftl; do
    printf '  %-7s %-4s  %s\n' "$t" "$(state "$t")" "$(describe "$t")"
  done
  # Retired markers do nothing, and silently reading as "still configured" is
  # exactly the confusion to avoid.
  for legacy in "$root/.claude-remote-ok" "$root/.claude-merge-ok" "$review_root/.claude-merge-auto" "$review_root/.claude-remote-auto"; do
    [[ -f "$legacy" ]] &&
      echo "  note: $legacy is a retired marker and has no effect — delete it"
  done
  return 0
}

# Flipping one toggle is the moment to reconsider the others.
offer_others() { # toggle state
  [[ -t 0 ]] || return 0
  for t in remote merge review; do
    [[ "$t" == "$1" ]] && continue
    cur=$(state "$t")
    want=$([[ "$cur" == on ]] && echo off || echo on)
    read -r -p "  also turn $t $want? ($(describe "$t")) [y/N] " ans || return 0
    [[ "$ans" =~ ^[Yy] ]] && apply "$t" "$want"
  done
}

case "${1:-}" in
  ""|status) status ;;
  all)
    [[ "${2:-}" == off ]] || die "only 'all off' is supported"
    for t in remote merge review; do apply "$t" off; done ;;
  remote|merge|review)
    case "${2:-}" in on|off) ;; *) die "usage: claude-gate $1 on|off" ;; esac
    apply "$1" "$2"
    offer_others "$1" "$2" ;;
  ftl)
    case "${2:-}" in on|off) ;; *) die "usage: claude-gate ftl on|off" ;; esac
    apply "$1" "$2" ;;
  *) die "unknown toggle '${1}' — try: status, remote, merge, review, ftl, all off" ;;
esac
