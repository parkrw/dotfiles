#!/usr/bin/env python3
# tasklog — the task and event log of one work context, in sqlite, so that
# concurrent sessions append rows instead of rewriting a shared PLAN.md.
#
#   cklog  <command>   CloudKey work, in ck.db
#   vanlog <command>   vanillin work, in van.db
#   tasklog <command>  the name whose origins match the cwd's repo
#
# --help prints the command lines below; <command> --help prints that one's.
#
#   plan add <slug> --path PLAN.md [--title T]
#   plan set <slug> [--path PLAN.md] [--title T]
#   plan list
#   state <plan> <code> <state> [--ref HEADING --pr N --head sha --branch B --worktree W
#                                --subject S --issue N --est S|M|L --owns GLOBS --deps CODES
#                                --model opus|fable --effort high|xhigh]
#   event <plan> <code> <kind> [text|-]
#         kinds: brief progress handoff report newchat note scope seed blocked review proof
#                finding checkpoint
#   decide <plan> <text|-> [--by who --quote Q]
#   show [plan] [--all] [--json]
#   log <plan> [code] [--since date]
#   flake add <test_id> [note] | list | rm <test_id> | match
#   brief <plan> <code>
#   gaps [plan]
#   suite-run --started T --exit N [--ended --worktree --branch --head --cmd --wait-ms --log --new --known]
#
# suite-run is how `suite` records a run; people read suite_runs with sqlite3.
#
# Every row is planned before it exists. Its plan has a plan file (plan add
# and plan set refuse a path that is not a file), the row names its section
# in that file with --ref, text that matches exactly one of its headings, and
# the row has a brief event. state refuses to create a row, or move one to an
# open state, without all three, and re-reads the plan file each time, so a
# ref whose heading was renamed or duplicated refuses too; merged and dropped
# stay open to every row, so old rows can close. brief prints the plan
# section whole, and gaps lists every plan and open row that still lacks one.
# These refusals exit 1, never 2, which callers read as "no log owns this
# repo" and skip.
#
# An event of kind progress is a handoff's state of play: what is done, what
# is next, where it stopped, what is open. brief prints the latest whole, as
# it prints the brief. Kinds outside the list are refused, so text passed
# where the kind goes fails instead of becoming a kind.
#
# --est, --owns and --deps are what /fan batches on: the size (S <=100 lines,
# M 100-300, L 300+), the write scope as space-separated globs, and the codes
# that must merge first, space-separated. --issue is the GitHub issue, when
# the plan uses issues at all. An open row missing est or owns gets a stderr
# line naming them, so every plan stays ready to fan.
#
# Every row carries the model and effort its task launches at, filled on
# each write from its size, correctness first: S runs opus at high, M, L and
# an unsized row opus at xhigh. --model and --effort override, never below
# opus at high. An event of kind model is refused and brief hides old ones,
# so the row is the only place a session reads them from.
#
# An event of kind brief is the row's hand-off to the session that builds it:
# what a fresh read of the repo will not give it. brief prints the latest one
# whole, ahead of the events, so later events never push it out. A planned
# row without one gets a stderr line, as a row missing est or owns does.
#
# A text argument of "-" is read from stdin, so text never passes through the
# shell, where quotes break it and the write gate reads it as a command.
#
# The names are separate DBs, and each refuses (exit 2) in a repo whose origin
# it does not own: vanlog never runs inside CloudKey repos, and cklog never in
# personal ones. Plans and flakes belong to the cwd's repo, so every worktree
# of a repo shares them.
#
# Python 3.9 stdlib only: macOS ships 3.9, and Ubuntu server and minimal
# images ship python3 with sqlite3, so it runs with nothing installed.
import argparse
import datetime
import json
import os
import re
import sqlite3
import subprocess
import sys
from urllib.request import pathname2url

NAMES = {
    "ck": {"db": "ck.db", "origins": ["github.com/CloudKey-io/*"]},
    "van": {"db": "van.db", "origins": ["github.com/parkrw/vanillin"]},
}
STATES = ["planned", "building", "review", "draft", "ready", "merged", "dropped", "blocked"]
CLOSED_SQL = "'merged','dropped'"
BRIEF_EVENTS = 10
ESTS = ["S", "M", "L"]
MODELS = ["opus", "fable"]
EFFORTS = ["high", "xhigh"]
RUN_BY_EST = {"S": ("opus", "high"), "M": ("opus", "xhigh"), "L": ("opus", "xhigh"), None: ("opus", "xhigh")}
FAN_FIELDS = ("est", "owns")
OPEN_STATES = [s for s in STATES if s not in ("merged", "dropped")]
# Kept in step with the header's kinds line, which help prints.
KINDS = ["brief", "progress", "handoff", "report", "newchat", "note", "scope", "seed", "blocked", "review",
         "proof", "finding", "checkpoint"]
WHOLE_KINDS = ("model", "brief", "progress")
HEADING = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")
FENCE = re.compile(r"^\s*(```|~~~)")
BUSY_TIMEOUT_S = 5


class Refused(Exception):
    pass


class Usage(Exception):
    pass


def origin_of(cwd):
    try:
        url = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                             capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None
    return normalize_origin(url)


# https://github.com/O/R.git, git@github.com:O/R and ssh://git@github.com/O/R
# all become github.com/O/R.
def normalize_origin(url):
    url = re.sub(r"^[a-z+]+://", "", url, flags=re.I)
    url = re.sub(r"^[^@/]+@", "", url)
    url = re.sub(r"^([^/:]+):(?!\d)", r"\1/", url)
    url = re.sub(r"\.git/?$", "", url)
    return re.sub(r"/+$", "", url)


# GitHub owner and repo names are case-insensitive.
def origin_matches(origin, pattern):
    regex = "[^/]+".join(re.escape(part) for part in pattern.split("*"))
    return re.fullmatch(regex, origin, flags=re.I) is not None


def owns(name, origin):
    return origin is not None and any(origin_matches(origin, p) for p in NAMES[name]["origins"])


def resolve_name(invoked, origin):
    from_argv = re.sub(r"log$", "", invoked)
    if from_argv in NAMES:
        if not owns(from_argv, origin):
            raise Refused(f"not a {from_argv} repo (origin: {origin or 'none'})")
        return from_argv
    for name in NAMES:
        if owns(name, origin):
            return name
    raise Refused(f"no log owns this repo (origin: {origin or 'none'})")


MIGRATIONS = [
    f"""CREATE TABLE plans (
       id INTEGER PRIMARY KEY,
       repo TEXT NOT NULL,
       slug TEXT NOT NULL,
       path TEXT,
       title TEXT,
       created TEXT NOT NULL,
       UNIQUE (repo, slug));
     CREATE TABLE prs (
       plan INTEGER NOT NULL REFERENCES plans(id),
       code TEXT NOT NULL,
       branch TEXT, worktree TEXT, pr INTEGER,
       state TEXT NOT NULL CHECK (state IN ({",".join(f"'{s}'" for s in STATES)})),
       head TEXT, subject TEXT,
       updated TEXT NOT NULL,
       PRIMARY KEY (plan, code));
     CREATE TABLE events (
       id INTEGER PRIMARY KEY,
       ts TEXT NOT NULL,
       plan INTEGER NOT NULL REFERENCES plans(id),
       code TEXT NOT NULL,
       kind TEXT NOT NULL,
       text TEXT,
       session TEXT);
     CREATE INDEX events_plan ON events (plan, code, ts);
     CREATE TABLE decisions (
       id INTEGER PRIMARY KEY,
       plan INTEGER NOT NULL REFERENCES plans(id),
       ts TEXT NOT NULL,
       text TEXT NOT NULL,
       said_by TEXT,
       quote TEXT);
     CREATE TABLE flakes (
       repo TEXT NOT NULL,
       test_id TEXT NOT NULL,
       note TEXT,
       added TEXT NOT NULL,
       last_seen TEXT,
       seen INTEGER NOT NULL DEFAULT 0,
       PRIMARY KEY (repo, test_id));
     CREATE TABLE suite_runs (
       id INTEGER PRIMARY KEY,
       repo TEXT NOT NULL,
       worktree TEXT, branch TEXT, head TEXT, cmd TEXT,
       started TEXT NOT NULL, ended TEXT,
       exit INTEGER, wait_ms INTEGER, log TEXT,
       new_reds INTEGER, known_reds INTEGER);""",
    """ALTER TABLE prs ADD COLUMN issue INTEGER;
     ALTER TABLE prs ADD COLUMN est TEXT;
     ALTER TABLE prs ADD COLUMN owns TEXT;
     ALTER TABLE prs ADD COLUMN deps TEXT;""",
    """ALTER TABLE prs ADD COLUMN model TEXT;
     ALTER TABLE prs ADD COLUMN effort TEXT;
     UPDATE prs SET model = 'opus', effort = CASE est WHEN 'S' THEN 'high' ELSE 'xhigh' END;""",
    """ALTER TABLE prs ADD COLUMN ref TEXT;""",
]


# As core's apps/api/src/db.js: a writer that sets WAL and migrates, and
# read-only readers. isolation_level=None leaves BEGIN and COMMIT to the code.
def open_writer(file):
    os.makedirs(os.path.dirname(file), exist_ok=True)
    db = sqlite3.connect(file, timeout=BUSY_TIMEOUT_S, isolation_level=None)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA foreign_keys=ON")
    with transaction(db):
        # Read inside the write lock, so two first runs never both migrate.
        version = db.execute("PRAGMA user_version").fetchone()[0]
        for sql in MIGRATIONS[version:]:
            for statement in sql.split(";"):
                if statement.strip():
                    db.execute(statement)
        if version < len(MIGRATIONS):
            db.execute(f"PRAGMA user_version={len(MIGRATIONS)}")
    return db


# A reader of a DB an older tasklog left behind migrates it first, so reads
# never meet a column that is not there yet.
def open_reader(file):
    if not os.path.exists(file):
        open_writer(file).close()
    db = sqlite3.connect(f"file:{pathname2url(file)}?mode=ro", uri=True,
                         timeout=BUSY_TIMEOUT_S, isolation_level=None)
    if db.execute("PRAGMA user_version").fetchone()[0] < len(MIGRATIONS):
        db.close()
        open_writer(file).close()
        return open_reader(file)
    db.row_factory = sqlite3.Row
    return db


class transaction:
    def __init__(self, db):
        self.db = db

    def __enter__(self):
        self.db.execute("BEGIN IMMEDIATE")

    def __exit__(self, kind, value, tb):
        self.db.execute("ROLLBACK" if kind else "COMMIT")


def iso(t):
    return t.astimezone(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.") + f"{t.microsecond // 1000:03d}Z"


def now():
    return iso(datetime.datetime.now(datetime.timezone.utc))


# A date alone is UTC midnight and a time with no offset is local time, as in
# JavaScript's Date, which the stored timestamps were first written with.
def parse_since(value):
    try:
        if re.fullmatch(r"\d{4}-\d\d-\d\d", value):
            return iso(datetime.datetime.fromisoformat(value).replace(tzinfo=datetime.timezone.utc))
        t = datetime.datetime.fromisoformat(re.sub(r"Z$", "+00:00", value))
    except ValueError:
        raise Usage(f"--since: not a date: {value}") from None
    return iso(t if t.tzinfo else t.astimezone())


def read_stdin():
    return sys.stdin.buffer.read().decode("utf-8", "replace")


def text_arg(value):
    return re.sub(r"\n$", "", read_stdin()) if value == "-" else value


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Usage(message)


def args(argv, options=(), flags=(), lo=0, hi=None):
    parser = Parser(add_help=False, allow_abbrev=False)
    for o in options:
        parser.add_argument(f"--{o}")
    for f in flags:
        parser.add_argument(f"--{f}", action="store_true")
    parser.add_argument("positionals", nargs="*")
    parsed = parser.parse_intermixed_args(argv)
    n = len(parsed.positionals)
    hi = lo if hi is None else hi
    if n < lo or n > hi:
        raise Usage(f"expected {lo if lo == hi else f'{lo}-{hi}'} arguments, got {n}")
    # A blank flake id is a substring of every test id, and a blank slug or
    # code is a row nothing can name; an unset shell variable produces either.
    if any(not p.strip() for p in parsed.positionals):
        raise Usage("arguments must not be blank")
    parsed.positionals += [None] * (hi - n)
    return parsed


def plan_row(db, repo, slug):
    row = db.execute("SELECT * FROM plans WHERE repo = ? AND slug = ?", (repo, slug)).fetchone()
    if row is None:
        raise Usage(f"no plan {slug} in {repo}; add it with: plan add {slug}")
    return row


def table(rows, cols):
    if not rows:
        return ""
    cells = [["" if r[c] is None else str(r[c]) for c in cols] for r in rows]
    width = [max([len(c)] + [len(r[i]) for r in cells]) for i, c in enumerate(cols)]

    def line(r):
        return "  ".join(s.ljust(width[i]) for i, s in enumerate(r)).rstrip()

    return "\n".join([line(cols)] + [line(r) for r in cells]) + "\n"


def plan_file(ctx, path):
    file = os.path.normpath(os.path.join(ctx["cwd"], os.path.expanduser(path)))
    if not os.path.isfile(file):
        raise Usage(f"--path: no plan file at {file}")
    return file


def read_plan(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().split("\n")
    except OSError:
        return None


# Headings outside fenced code, as (line index, level, text): a "# comment"
# inside a shell block is not a section.
def headings(lines):
    out, fence = [], None
    for i, line in enumerate(lines):
        m = FENCE.match(line)
        if m:
            fence = None if fence == m.group(1) else (fence or m.group(1))
            continue
        m = None if fence else HEADING.match(line)
        if m:
            out.append((i, len(m.group(1)), m.group(2)))
    return out


# The headings ref names: it matches as whole words, case-insensitively, so
# T1 never matches T10.
def ref_matches(lines, ref):
    pattern = re.compile(r"(?<!\w)" + re.escape(ref.strip()) + r"(?!\w)", re.I)
    return [h for h in headings(lines) if pattern.search(h[2])]


# The section from ref's heading to the next heading at its level or above.
def section(lines, ref):
    found = ref_matches(lines, ref)
    if len(found) != 1:
        return None
    start, level, _ = found[0]
    end = next((i for i, lv, _ in headings(lines) if i > start and lv <= level), len(lines))
    return "\n".join(lines[start:end]).strip()


def check_ref(plan, ref):
    lines = read_plan(plan["path"])
    if lines is None:
        raise Usage(f"plan {plan['slug']}'s file is gone: {plan['path']}; point it at the plan with "
                    f"plan set {plan['slug']} --path P")
    found = ref_matches(lines, ref)
    if len(found) != 1:
        names = "; ".join(h[2] for h in found[:5])
        raise Usage(f"--ref {ref!r} matches {len(found)} headings in {plan['path']}"
                    + (f" ({names}); quote more of one" if found else "; it must name the row's section"))


def has_brief(db, plan, code):
    return db.execute("SELECT 1 FROM events WHERE plan = ? AND code = ? AND kind = 'brief'",
                      (plan["id"], code)).fetchone() is not None


def cmd_plan(db, ctx, argv):
    sub, rest = (argv[0], argv[1:]) if argv else (None, [])
    if sub == "add":
        a = args(rest, options=("path", "title"), lo=1)
        slug = a.positionals[0]
        if a.path is None:
            raise Usage("plan add needs --path: the plan file its rows name sections of")
        db.execute("INSERT INTO plans (repo, slug, path, title, created) VALUES (?, ?, ?, ?, ?)",
                   (ctx["repo"], slug, plan_file(ctx, a.path), a.title, now()))
        return f"plan {slug} added\n"
    if sub == "set":
        a = args(rest, options=("path", "title"), lo=1)
        plan = plan_row(db, ctx["repo"], a.positionals[0])
        if a.path is None and a.title is None:
            raise Usage("plan set needs --path or --title")
        db.execute("UPDATE plans SET path = coalesce(?, path), title = coalesce(?, title) WHERE id = ?",
                   (a.path and plan_file(ctx, a.path), a.title, plan["id"]))
        return ""
    if sub == "list":
        args(rest)
        rows = db.execute(
            f"""SELECT slug, title, path,
                  (SELECT count(*) FROM prs WHERE prs.plan = plans.id AND state NOT IN ({CLOSED_SQL})) AS open
                FROM plans WHERE repo = ? ORDER BY slug""", (ctx["repo"],)).fetchall()
        return table(rows, ["slug", "open", "title", "path"])
    raise Usage("plan add <slug> --path P | plan set <slug> | plan list")


def cmd_state(db, ctx, argv):
    a = args(argv, options=("ref", "pr", "head", "branch", "worktree", "subject", "issue", "est", "owns", "deps",
                                   "model", "effort"), lo=3)
    slug, code, state = a.positionals
    if state not in STATES:
        raise Usage(f"state must be one of {'|'.join(STATES)}")
    for k in ("pr", "issue"):
        if getattr(a, k) is not None and not re.fullmatch(r"\d+", getattr(a, k)):
            raise Usage(f"--{k} takes a number")
    if a.est is not None and a.est not in ESTS:
        raise Usage(f"--est must be one of {'|'.join(ESTS)}")
    if a.model is not None and a.model not in MODELS:
        raise Usage(f"--model must be one of {'|'.join(MODELS)}; code runs at opus or above")
    if a.effort is not None and a.effort not in EFFORTS:
        raise Usage(f"--effort must be one of {'|'.join(EFFORTS)}; code runs at high or above")
    if a.ref is not None and not a.ref.strip():
        raise Usage("--ref must not be blank")
    plan = plan_row(db, ctx["repo"], slug)
    if a.ref is not None:
        check_ref(plan, a.ref)
    ts = now()
    fields = {"ref": a.ref and a.ref.strip(), "branch": a.branch, "worktree": a.worktree, "pr": a.pr and int(a.pr),
              "head": a.head, "subject": a.subject, "issue": a.issue and int(a.issue), "est": a.est,
              "owns": a.owns and " ".join(a.owns.split()), "deps": a.deps and " ".join(a.deps.split()),
              "model": None, "effort": None}
    with transaction(db):
        old = db.execute("SELECT est, model, effort, ref FROM prs WHERE plan = ? AND code = ?",
                         (plan["id"], code)).fetchone()
        if old is None or state in OPEN_STATES:
            refuse_unplanned(db, plan, code, fields["ref"] or (old and old["ref"]), state, old is None)
        fields["model"], fields["effort"] = pick_run(old, a)
        # An option left out keeps the row's earlier value.
        db.execute(
            """INSERT INTO prs (plan, code, ref, branch, worktree, pr, state, head, subject, issue, est, owns, deps,
                                model, effort, updated)
               VALUES (:plan, :code, :ref, :branch, :worktree, :pr, :state, :head, :subject, :issue, :est, :owns,
                       :deps, :model, :effort, :ts)
               ON CONFLICT (plan, code) DO UPDATE SET
                 ref = coalesce(:ref, ref), branch = coalesce(:branch, branch), worktree = coalesce(:worktree, worktree),
                 pr = coalesce(:pr, pr), state = :state, head = coalesce(:head, head),
                 subject = coalesce(:subject, subject), issue = coalesce(:issue, issue),
                 est = coalesce(:est, est), owns = coalesce(:owns, owns), deps = coalesce(:deps, deps),
                 model = :model, effort = :effort, updated = :ts""",
            dict(fields, plan=plan["id"], code=code, state=state, ts=ts))
        detail = [f"{k}={v}" for k, v in fields.items() if v is not None]
        db.execute("INSERT INTO events (ts, plan, code, kind, text, session) VALUES (?, ?, ?, 'state', ?, ?)",
                   (ts, plan["id"], code, " ".join([state] + detail), ctx["session"]))
        row = db.execute("SELECT * FROM prs WHERE plan = ? AND code = ?", (plan["id"], code)).fetchone()
    missing = [k for k in FAN_FIELDS if row[k] is None]
    if missing and state not in ("merged", "dropped"):
        sys.stderr.write(f"not fan-ready: {slug} {code} lacks {' '.join('--' + k for k in missing)}\n")
    return f"{slug} {code}: {state}\n"


# A row is planned before it exists or works: its plan has a file, it names
# its section there, and it has a brief. All of what is missing in one line.
def refuse_unplanned(db, plan, code, ref, state, new):
    slug, missing = plan["slug"], []
    lines = plan["path"] and read_plan(plan["path"])
    if not plan["path"]:
        missing.append(f"a plan file (plan set {slug} --path P)")
    elif lines is None:
        missing.append(f"its plan file, gone from {plan['path']} (plan set {slug} --path P)")
    if not ref:
        missing.append("its section in the plan (--ref HEADING)")
    elif lines is not None and len(ref_matches(lines, ref)) != 1:
        missing.append(f"its section, since --ref {ref!r} no longer matches one heading of {plan['path']}")
    if not has_brief(db, plan, code):
        missing.append(f"a brief (event {slug} {code} brief -, text on stdin)")
    if missing:
        what = "create" if new else f"move to {state}"
        raise Usage(f"refused: {slug} {code} cannot {what} without {', '.join(missing)}")


# A run the row's size picked follows the size when it changes; a run set with
# --model or --effort stays until one of them is passed again.
def pick_run(old, a):
    est = a.est or (old and old["est"])
    if old is None or old["model"] is None or (old["model"], old["effort"]) == RUN_BY_EST[old["est"]]:
        model, effort = RUN_BY_EST[est]
    else:
        model, effort = old["model"], old["effort"]
    return a.model or model, a.effort or effort


def cmd_event(db, ctx, argv):
    slug, code, kind, text = args(argv, lo=3, hi=4).positionals
    if kind == "model":
        raise Usage("a row's model and effort are columns: state <plan> <code> <state> --model M --effort E")
    if kind == "state":
        raise Usage("state events are written by: state <plan> <code> <state>")
    if kind == "decision":
        raise Usage("decisions are the plan's: decide <plan> <text|->")
    if kind not in KINDS:
        raise Usage(f"kind must be one of {' '.join(KINDS)}; text goes after it, or on stdin as -")
    plan = plan_row(db, ctx["repo"], slug)
    db.execute("INSERT INTO events (ts, plan, code, kind, text, session) VALUES (?, ?, ?, ?, ?, ?)",
               (now(), plan["id"], code, kind, None if text is None else text_arg(text), ctx["session"]))
    return ""


def cmd_decide(db, ctx, argv):
    a = args(argv, options=("by", "quote"), lo=2)
    slug, text = a.positionals
    plan = plan_row(db, ctx["repo"], slug)
    db.execute("INSERT INTO decisions (plan, ts, text, said_by, quote) VALUES (?, ?, ?, ?, ?)",
               (plan["id"], now(), text_arg(text), a.by, a.quote))
    return ""


def cmd_show(db, ctx, argv):
    a = args(argv, flags=("all", "json"), lo=0, hi=1)
    slug = a.positionals[0]
    where, params = ["plans.repo = ?"], [ctx["repo"]]
    if slug:
        where.append("plans.id = ?")
        params.append(plan_row(db, ctx["repo"], slug)["id"])
    if not a.all:
        where.append(f"prs.state NOT IN ({CLOSED_SQL})")
    rows = [dict(r) for r in db.execute(
        f"""SELECT plans.slug AS plan, prs.code, prs.ref, prs.state, prs.pr, prs.branch, prs.head, prs.subject,
                   prs.worktree, prs.issue, prs.est, prs.owns, prs.deps, prs.model, prs.effort, prs.updated
            FROM prs JOIN plans ON plans.id = prs.plan
            WHERE {" AND ".join(where)} ORDER BY plans.slug, prs.code""", params)]
    if a.json:
        return json.dumps(rows, indent=2, ensure_ascii=False) + "\n"
    for r in rows:
        r["head"] = r["head"] and r["head"][:12]
        r["updated"] = r["updated"][:16]
        r["run"] = r["model"] and f"{r['model']}/{r['effort']}"
    return table(rows, ["plan", "code", "state", "issue", "est", "run", "pr", "branch", "head", "updated", "subject"])


def cmd_log(db, ctx, argv):
    a = args(argv, options=("since",), lo=1, hi=2)
    slug, code = a.positionals
    plan = plan_row(db, ctx["repo"], slug)
    since = None if a.since is None else parse_since(a.since)
    rows = db.execute(
        """SELECT ts, code, kind, text FROM events
           WHERE plan = :plan AND (:code IS NULL OR code = :code) AND (:since IS NULL OR ts >= :since)
           ORDER BY ts, id""", {"plan": plan["id"], "code": code, "since": since}).fetchall()
    return "".join(f"{r['ts'][:16]}  {r['code']}  {r['kind']}{'  ' + r['text'] if r['text'] else ''}\n"
                   for r in rows)


def cmd_flake(db, ctx, argv):
    sub, rest = (argv[0], argv[1:]) if argv else (None, [])
    if sub == "add":
        test_id, note = args(rest, lo=1, hi=2).positionals
        db.execute("INSERT INTO flakes (repo, test_id, note, added) VALUES (?, ?, ?, ?) "
                   "ON CONFLICT DO UPDATE SET note = excluded.note",
                   (ctx["repo"], test_id.strip(), note, now()))
        return ""
    if sub == "list":
        args(rest)
        rows = [dict(r) for r in db.execute(
            "SELECT test_id, note, seen, last_seen FROM flakes WHERE repo = ? ORDER BY test_id", (ctx["repo"],))]
        for r in rows:
            r["last_seen"] = r["last_seen"] and r["last_seen"][:10]
        return table(rows, ["test_id", "seen", "last_seen", "note"])
    if sub == "rm":
        test_id = args(rest, lo=1).positionals[0]
        if not db.execute("DELETE FROM flakes WHERE repo = ? AND test_id = ?",
                          (ctx["repo"], test_id.strip())).rowcount:
            raise Usage(f"no flake {test_id}")
        return ""
    if sub == "match":
        args(rest)
        # A flake's test_id matches every red id that contains it, so one entry
        # covers a test whose id carries a line number or a parameter.
        flakes = [r["test_id"] for r in db.execute("SELECT test_id FROM flakes WHERE repo = ?", (ctx["repo"],))]
        ts = now()
        ids = [s.strip() for s in read_stdin().split("\n") if s.strip()]
        out = ""
        with transaction(db):
            for test_id in ids:
                hit = next((f for f in flakes if f in test_id), None)
                if hit is not None:
                    db.execute("UPDATE flakes SET seen = seen + 1, last_seen = ? WHERE repo = ? AND test_id = ?",
                               (ts, ctx["repo"], hit))
                out += f"{'NEW' if hit is None else 'KNOWN'} {test_id}\n"
        return out
    raise Usage("flake add <test_id> [note] | list | rm <test_id> | match")


def cmd_brief(db, ctx, argv):
    slug, code = args(argv, lo=2).positionals
    plan = plan_row(db, ctx["repo"], slug)
    pr = db.execute("SELECT * FROM prs WHERE plan = ? AND code = ?", (plan["id"], code)).fetchone()
    decisions = db.execute("SELECT ts, text, said_by, quote FROM decisions WHERE plan = ? ORDER BY ts, id",
                           (plan["id"],)).fetchall()
    def latest(kind):
        return db.execute("SELECT ts, text FROM events WHERE plan = ? AND code = ? AND kind = ? "
                          "ORDER BY ts DESC, id DESC LIMIT 1", (plan["id"], code, kind)).fetchone()

    task, progress = latest("brief"), latest("progress")
    events = db.execute(f"SELECT ts, kind, text FROM events WHERE plan = ? AND code = ? "
                        f"AND kind NOT IN ({','.join('?' * len(WHOLE_KINDS))}) "
                        f"ORDER BY ts DESC, id DESC LIMIT ?",
                        (plan["id"], code, *WHOLE_KINDS, BRIEF_EVENTS)).fetchall()[::-1]
    flakes = db.execute("SELECT test_id, note FROM flakes WHERE repo = ? ORDER BY test_id", (ctx["repo"],)).fetchall()
    out = [f"# {plan['slug']} {code}{' — ' + plan['title'] if plan['title'] else ''}", ""]
    ref = pr and pr["ref"]
    out += [f"Plan: {plan['path'] or 'none recorded'}", f"Ref: {ref or 'none recorded'}", "", "## Plan section", ""]
    lines = plan["path"] and read_plan(plan["path"])
    if not plan["path"] or not ref:
        out.append("None recorded.")
    elif lines is None:
        out.append(f"Plan file gone: {plan['path']}")
    else:
        out.append(section(lines, ref) or f"No single heading in the plan matches {ref!r} now.")
    out += ["", "## PR", ""]
    if pr:
        out += [f"- {k}: {pr[k]}" for k in ("state", "model", "effort", "issue", "est", "owns", "deps", "pr", "branch", "worktree",
                                              "head", "subject", "updated")
                if pr[k] is not None]
    else:
        out.append("No row yet.")
    out += ["", "## Brief", "", task["text"] if task and task["text"] else "None recorded."]
    out += ["", "## Progress", ""]
    out.append(f"{progress['ts'][:16]}\n\n{progress['text']}" if progress and progress["text"] else "None recorded.")
    out += ["", "## Decisions", ""]
    if not decisions:
        out.append("None recorded.")
    for d in decisions:
        by = f" ({d['said_by']})" if d["said_by"] else ""
        out.append(f"- {d['ts'][:10]} {d['text']}{by}")
        if d["quote"]:
            out.append("  > " + d["quote"].replace("\n", "\n  > "))
    out += ["", f"## Last {BRIEF_EVENTS} events", ""]
    if not events:
        out.append("None recorded.")
    out += [f"- {e['ts'][:16]} {e['kind']}{': ' + e['text'] if e['text'] else ''}" for e in events]
    out += ["", "## Known flakes", ""]
    if not flakes:
        out.append("None recorded.")
    out += [f"- `{f['test_id']}`{' — ' + f['note'] if f['note'] else ''}" for f in flakes]
    return "\n".join(out) + "\n"


def cmd_gaps(db, ctx, argv):
    slug = args(argv, lo=0, hi=1).positionals[0]
    plans = [plan_row(db, ctx["repo"], slug)] if slug else \
        db.execute("SELECT * FROM plans WHERE repo = ? ORDER BY slug", (ctx["repo"],)).fetchall()
    out = []
    for plan in plans:
        lines = plan["path"] and read_plan(plan["path"])
        rows = db.execute(f"SELECT * FROM prs WHERE plan = ? AND state NOT IN ({CLOSED_SQL}) ORDER BY code",
                          (plan["id"],)).fetchall()
        if not plan["path"] or lines is None:
            out.append({"plan": plan["slug"], "code": "", "state": "",
                        "missing": "plan file" + (f" (gone: {plan['path']})" if plan["path"] else "")})
        for r in rows:
            missing = []
            if not r["ref"]:
                missing.append("ref")
            elif lines is not None and len(ref_matches(lines, r["ref"])) != 1:
                missing.append("ref (no single heading)")
            if not has_brief(db, plan, r["code"]):
                missing.append("brief")
            missing += [k for k in FAN_FIELDS if r[k] is None]
            if missing:
                out.append({"plan": plan["slug"], "code": r["code"], "state": r["state"], "missing": " ".join(missing)})
    return table(out, ["plan", "code", "state", "missing"])


def cmd_suite_run(db, ctx, argv):
    ints = ("exit", "wait-ms", "new", "known")
    a = vars(args(argv, options=("worktree", "branch", "head", "cmd", "started", "ended", "log") + ints))
    for k in ("started", "exit"):
        if a[k] is None:
            raise Usage(f"--{k} required")
    for k in ints:
        k = k.replace("-", "_")
        if a[k] is not None and not re.fullmatch(r"\d+", a[k]):
            raise Usage(f"--{k.replace('_', '-')} takes a whole number")
        a[k] = None if a[k] is None else int(a[k])
    db.execute(
        """INSERT INTO suite_runs (repo, worktree, branch, head, cmd, started, ended, exit, wait_ms, log,
                                   new_reds, known_reds)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
        (ctx["repo"], a["worktree"] or None, a["branch"] or None, a["head"] or None, a["cmd"], a["started"],
         a["ended"], a["exit"], a["wait_ms"], a["log"], a["new"], a["known"]))
    return ""


COMMANDS = {
    "plan": cmd_plan, "state": cmd_state, "event": cmd_event, "decide": cmd_decide, "show": cmd_show,
    "log": cmd_log, "flake": cmd_flake, "brief": cmd_brief, "gaps": cmd_gaps, "suite-run": cmd_suite_run,
}
READS = {("show",), ("log",), ("brief",), ("gaps",), ("plan", "list"), ("flake", "list")}


# The header comment is the only copy of the usage, so help cannot drift from it.
def usage(invoked, command=None):
    out, keep = [], False
    with open(__file__) as f:
        for line in f:
            if not line.startswith("#"):
                break
            text = line[4:].rstrip() if line.startswith("#   ") else ""
            if text and not text[0].isspace():
                keep = text.split()[0] in COMMANDS and command in (None, text.split()[0])
                if keep:
                    out.append(f"{invoked} {text}")
            elif text and keep:
                out.append(" " * (len(invoked) + 1) + text)
            else:
                keep = False
    return "\n".join(out) + "\n"


def main():
    invoked = os.path.basename(sys.argv[0])
    command, argv = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else (None, [])
    # Before resolving the name: help must work outside any owned repo and open no DB.
    if command in (None, "--help", "help"):
        sys.stdout.write(usage(invoked))
        return 0
    if command in COMMANDS and "--help" in argv:
        sys.stdout.write(usage(invoked, command))
        return 0
    try:
        if command not in COMMANDS:
            raise Usage(f"commands: {', '.join(COMMANDS)}")
        cwd = os.getcwd()
        origin = origin_of(cwd)
        name = resolve_name(invoked, origin)
        file = os.path.join(os.environ.get("TASKLOG_DIR") or os.path.expanduser("~/.local/state/claude/tasks"),
                            NAMES[name]["db"])
        reads = (command,) in READS or (command, argv[0] if argv else None) in READS
        db = open_reader(file) if reads else open_writer(file)
        ctx = {"cwd": cwd, "repo": origin.lower(), "session": os.environ.get("CLAUDE_CODE_SESSION_ID") or None}
        try:
            sys.stdout.write(COMMANDS[command](db, ctx, argv))
        finally:
            db.close()
    except (Refused, Usage, sqlite3.Error) as e:
        sys.stderr.write(f"{invoked}: {e}\n")
        return 2 if isinstance(e, Refused) else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
