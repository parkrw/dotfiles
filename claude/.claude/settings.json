{
  "cleanupPeriodDays": 90,
  "syncClaudeAiSkills": false,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-4-6[1m]"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Artifact",
      "EnterWorktree",
      "ExitWorktree",
      "Monitor",
      "Edit(~/.local/state/claude/fan/**)",
      "Write(~/.local/state/claude/fan/**)",
      "Bash(tmux new-window:*)",
      "Bash(gh list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(tmux paste-buffer:*)",
      "Bash(tmux send-keys:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "mcp__clickup",
      "mcp__atlassian",
      "ShareOnboardingGuide",
      "ReportFindings",
      "ListAgents",
      "SendFeedback",
      "ScheduleWakeup",
      "Bash(gh pr merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(git commit -a:*)",
      "Bash(git commit -am:*)",
      "Bash(git commit --all:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(dd:*)",
      "Bash(shred:*)"
    ],
    "ask": [
      "Agent",
      "Bash(rm:*)",
      "Bash(rmdir:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/Developments/work/ck/programmin",
      "~/Developments/progrums"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "handoff": "off",
    "slice": "off"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/rename-plans.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/ctx-handoff-nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/ftl-stop-gate.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/bottle.aiff"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/notify.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/bash-write-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/git-state-inject.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/pr-size-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/agent-ask-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/outcome-assert-gate.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/ftl-mode.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/tool-cadence-reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/branch-size-warn.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/turn-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/ftl-every-prompt.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/scripts/ftl-mode.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": false,
    "js-lsp@local-plugins": true,
    "iso-24495-plain-language@iso-24495": false
  },
  "extraKnownMarketplaces": {
    "iso-24495": {
      "source": {
        "source": "git",
        "url": "https://github.com/GaZmagik/iso-24495.git"
      }
    }
  },
  "outputStyle": "iso-24495-plain-language:ISO 24495",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-4-6": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "iterm2_with_bell",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "autoScrollEnabled": true,
  "wheelScrollAccelerationEnabled": false,
  "fileCheckpointingEnabled": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: CloudKey-io (github.com/CloudKey-io) — scoped to this repo's remote",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: private (CloudKey-io/core, confirmed via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default); rulesets on `main` are disabled and no classic protected branches are listed — treat `main` as unprotected but still never commit to it directly per repo git-safety rules",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (CloudKey-io/core) and its origin remote only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar; note repo-flagged candidates `.env`/`.env.*` (gitignored), `.envrc`, `apps/api/test/secret-store.test.js`",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic (k8s namespaces seen in transcripts: apps, hbops, zerto — none carry a prod/production segment)",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: CloudKey-io/core (this checkout and its origin remote), private — confidential material (non-secret) is fine to commit here; secrets and personal/regulated data are never cleared into it by visibility alone",
      "**Org-specific CLIs**: None configured",
      "**routine under CloudKey-io/core prefix**: staging named paths and commit run without a prompt, except `--amend`, `--no-verify`, a detached-HEAD commit and a pathspec the gate cannot place in the repo (for example `$var`, `~`, a `..` climb, an absolute path outside it, `--pathspec-from-file`, exclude or attr magic), which ask, and bulk staging (`git add -A`/`-u` or a whole-tree pathspec like `.`, `./`, `:/`, `*`; `git commit -a` in any flag cluster or with such a pathspec) and a commit on main/master, which are denied; other local git mutations (branch, stash, local merge/rebase) ask before running; read-only git/gh commands run without a prompt; `git push` of a feature branch and `gh pr create` run without a prompt; other mutating `gh` commands ask; a push to main/master or the default branch, a force-push, a tag push and `gh pr merge` are permanently denied; integrating from a remote (`git pull`, `git merge origin/…`) is permanently denied"
    ]
  },
  "voiceEnabled": true
}
